# Скопируйте в .env и поправьте значения

# Режим работы: development | test | production
NODE_ENV=development

# Порт HTTP-сервера
PORT=3000

# Строка подключения к PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rest_api_forge

# Секрет подписи JWT (минимум 8 символов, в production — длинная случайная строка)
JWT_SECRET=change-me-to-a-long-random-string

# Срок жизни access-токена (формат пакета jsonwebtoken)
JWT_EXPIRES_IN=1h

# Уровень логирования: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# CORS: разрешённые источники через запятую. Пусто — CORS выключен; "*" — любой (dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limit на /auth/*: окно (мс) и предел запросов на IP за окно (15 мин / 10)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Учётные данные администратора для npm run db:seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-password
